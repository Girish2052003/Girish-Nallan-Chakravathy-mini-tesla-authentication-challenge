# Git skips matching untracked files so local tools and secrets stay out of commits.
# These rules do not remove files that were already tracked in Git history.
# Keep the machine's private Python environment out of the repository.
.venv/
# Python stores generated bytecode in these cache directories.
__pycache__/
# Also ignore loose compiled Python files ending in .pyc, .pyo, or .pyd.
*.py[cod]
# pytest stores temporary test bookkeeping here.
.pytest_cache/
# Package installation/build tools generate these metadata directories.
*.egg-info/
# Built distributable packages and intermediate build files are generated output.
dist/
build/
# A real environment file may contain a secret master key; never add it.
.env
# Encrypted keystore files are local runtime data, not source code.
*.enc
# TLC's generated logs and model-exploration states are reproducible output.
verification/model/results/
# The pinned model checker is downloaded and verified, not committed as a binary.
verification/model/tla2tools.jar
